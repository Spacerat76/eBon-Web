# Keep source files stable across Windows hosts and Linux devcontainers.
* text=auto eol=lf

# Windows command files are expected to use CRLF.
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Common binary artifacts.
*.class binary
*.gif binary
*.ico binary
*.jar binary
*.jpeg binary
*.jpg binary
*.pdf binary
*.png binary
*.webp binary
*.woff binary
*.woff2 binary
*.zip binary
