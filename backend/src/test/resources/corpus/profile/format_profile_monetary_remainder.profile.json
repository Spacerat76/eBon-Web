{
  "schemaVersion": 1,
  "anchors": [
    {"id": "merchant", "regex": "^TESTMARKT$", "required": true},
    {"id": "start", "regex": "^ARTIKEL PREIS$", "required": true},
    {"id": "end", "regex": "^SUMME .+$", "required": true}
  ],
  "fields": [
    {"field": "STORE_NAME", "regex": "^(TESTMARKT)$", "captureGroup": 1, "required": true},
    {"field": "RECEIPT_DATE", "regex": "^([0-9]{2}\\.[0-9]{2}\\.[0-9]{4})$", "captureGroup": 1, "required": true},
    {"field": "TOTAL_AMOUNT", "regex": "^SUMME (.+)$", "captureGroup": 1, "required": true}
  ],
  "itemRules": [
    {"regex": "^(Bio Apfel) ([0-9]+,[0-9]{2}).*$", "captures": {"DESCRIPTION": 1, "TOTAL_PRICE": 2},
      "region": {"startAnchor": "start", "endAnchor": "end"}, "type": "ITEM"}
  ],
  "lineRules": []
}
