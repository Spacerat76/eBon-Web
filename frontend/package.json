    "@testing-library/jest-dom": "^6.0.0",
    "jsdom": "^21.1.0",
    "typescript": "^5.7.0",
    "@playwright/test": "^1.46.0",
    "@vitejs/plugin-react": "^4.0.0",
    "tailwindcss": "^3.4.7",
    "@tailwindcss/forms": "^0.5.3",
