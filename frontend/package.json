{
  "name": "ebon-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.node.json --noEmit && vite build",
    "dev:e2e": "cross-env VITE_EBON_MOCK_API=true vite --host 127.0.0.1 --port 5173 --strictPort",
    "e2e": "node e2e/run-smoke.mjs",
    "preview": "vite preview --host 0.0.0.0"
  },
  "dependencies": {
    "@tailwindcss/vite": "4.3.0",
    "lucide-react": "1.17.0",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "recharts": "3.8.1",
    "tailwindcss": "4.3.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "6.0.2",
    "chromedriver": "^149.0.3",
    "cross-env": "^10.1.0",
    "edgedriver": "^6.3.0",
    "selenium-webdriver": "^4.38.0",
    "typescript": "6.0.3",
    "vite": "8.0.16"
  }
}
