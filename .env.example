# eBon Web example environment.
# Copy to .env and replace values before running a real integration.
# Never commit real tokens or passwords.

# DB_HOST=db targets the Compose database service inside the Devcontainer.
# If you run the backend directly on the host, switch this to localhost.
DB_HOST=db
DB_PORT=5432
DB_NAME=ebon
DB_USER=ebon
DB_PASSWORD=ebon_dev_password

APP_API_TOKEN=change_me_local_dev_token
APP_OPENAPI_PUBLIC_ACCESS=false
SPRINGDOC_API_DOCS_ENABLED=true
SPRINGDOC_SWAGGER_UI_ENABLED=true

PAPERLESS_BASE_URL=http://localhost:8000
PAPERLESS_PUBLIC_BASE_URL=http://localhost:8000
PAPERLESS_DOCUMENT_URL_TEMPLATE=
PAPERLESS_API_TOKEN=change_me_paperless_token
PAPERLESS_EBON_TAG=eBON

# PAPERLESS_BASE_URL is used by the backend/container for API calls.
# PAPERLESS_PUBLIC_BASE_URL is used for browser links in the UI.
# PAPERLESS_DOCUMENT_URL_TEMPLATE can override document links, for example:
# http://paperless.local/documents/{paperlessDocumentId}/details

OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-oss-20b
OPENROUTER_PARSING_MODEL=openai/gpt-oss-20b
OPENROUTER_PARSING_MAX_TOKENS=2500
OPENROUTER_PARSING_TEMPERATURE=0.0
AI_PARSING_FALLBACK_ENABLED=true
AI_PARSING_MIN_CONFIDENCE=0.900
AI_PARSING_SYNC_CALL_LIMIT=25
AI_PARSING_TEXT_MODE=MINIMIZED
AI_PARSING_STORE_DEBUG_SNIPPETS=false

# Optional dm branch mapping for eBons whose address is embedded as an image.
# Prefer the base code before "/" so D482/1 and D482/2 resolve to the same branch.
# app.parser.dm-branch-mappings.D482=Example Street 1, 12345 Example City

SYNC_INTERVAL_MINUTES=60
SYNC_SCHEDULER_ENABLED=true
SYNC_INITIAL_DELAY_MS=3600000

# Optional automatic backups. Disabled by default.
# The Compose backend mounts this directory to the automatic_backups Docker volume.
ROLLING_BACKUP_ENABLED=false
ROLLING_BACKUP_DIRECTORY=/var/lib/ebon/backups/automatic
# Default in application.yml: 0 0 3 * * *
# Leave commented if you source .env in a shell, because cron expressions contain spaces.
# ROLLING_BACKUP_CRON=0 0 3 * * *
ROLLING_BACKUP_RETENTION_COUNT=7

LOG_LEVEL=INFO
LOG_STRUCTURED_FORMAT=logstash

# Root docker-compose.yml publishes the production-like frontend on this port.
# Use 80 if you want a traditional web port and it is free on your host.
FRONTEND_PORT=5173
BACKEND_PORT=8080
