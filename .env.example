# Example environment variables for eBon (copy to .env and fill values)
PAPERLESS_BASE_URL=
PAPERLESS_API_TOKEN=
PAPERLESS_EBON_TAG=eBON

OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_API_KEY=
OPENROUTER_MODEL=

APP_API_TOKEN=replace-with-your-token

SPRING_DATASOURCE_URL=jdbc:postgresql://db:5432/ebon
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=postgres

SYNC_INTERVAL_MINUTES=60
AI_RATE_LIMIT_PER_MINUTE=10
